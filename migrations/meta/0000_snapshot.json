        "entries_kind": {
          "name": "entries_kind",
          "value": "\"entries\".\"kind\" IN ('expense', 'income', 'transfer', 'adjustment')"
        },
        "entries_fx_state": {
          "name": "entries_fx_state",
          "value": "\"entries\".\"fx_state\" IN ('fixed', 'waiting', 'provisional')"
        },
        "entries_transfer_target": {
          "name": "entries_transfer_target",
          "value": "(\"entries\".\"kind\" = 'transfer') = (\"entries\".\"to_account_id\" IS NOT NULL AND \"entries\".\"to_amount_minor\" IS NOT NULL)"
        },
        "entries_transfer_distinct": {
          "name": "entries_transfer_distinct",
          "value": "\"entries\".\"to_account_id\" IS NULL OR \"entries\".\"to_account_id\" <> \"entries\".\"account_id\""
        },
        "entries_amount_sign": {
          "name": "entries_amount_sign",
          "value": "CASE WHEN \"entries\".\"kind\" = 'adjustment' THEN \"entries\".\"account_amount_minor\" <> 0 ELSE \"entries\".\"account_amount_minor\" > 0 END"
        },
        "entries_to_amount_positive": {
          "name": "entries_to_amount_positive",
          "value": "\"entries\".\"to_amount_minor\" IS NULL OR \"entries\".\"to_amount_minor\" > 0"
        },
        "entries_category": {
          "name": "entries_category",
          "value": "(\"entries\".\"kind\" IN ('expense', 'income')) = (\"entries\".\"category_id\" IS NOT NULL)"
        },
        "entries_orig_pair": {
          "name": "entries_orig_pair",
          "value": "(\"entries\".\"orig_currency\" IS NULL) = (\"entries\".\"orig_amount_minor\" IS NULL)"
        },
        "entries_base_waiting": {
          "name": "entries_base_waiting",
          "value": "(\"entries\".\"fx_state\" = 'waiting') = (\"entries\".\"base_amount_minor\" IS NULL)"
        }
      }
